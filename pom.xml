	<profiles>
		<!--
			Publishing to Maven Central:  mvn clean deploy -P release
			Needs a 'central' server (Central Portal user token) in ~/.m2/settings.xml and a GPG key.
			Normal builds (mvn install) do not use this profile and need neither.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<doclint>none</doclint>
							<quiet>true</quiet>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<configuration>
							<!--
								Pure-Java signer: does not call gpg.exe (Git for Windows' gpg reports "2.4.7-unknown",
								which the default signer cannot parse). It reads the exported secret key from
								~/maven-signing-key.key (or the MAVEN_GPG_KEY env var) and the passphrase from
								MAVEN_GPG_PASSPHRASE. The key file lives outside the project and is never committed.
							-->
							<signer>bc</signer>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.7.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- false: upload and validate only; press Publish in the Central Portal after checking -->
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<pdfbox.version>3.0.3</pdfbox.version>
		<gson.version>2.12.1</gson.version>
		<commons.io.version>2.18.0</commons.io.version>
		<muleJavaEeBomVersion>4.6.11</muleJavaEeBomVersion>
	</properties>

	<dependencyManagement>
