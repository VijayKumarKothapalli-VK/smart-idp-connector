	<parent>
		<groupId>org.mule.extensions</groupId>
		<artifactId>mule-modules-parent</artifactId>
		<version>1.6.13</version>
	</parent>

	<groupId>io.github.vijaykumarkothapalli-vk</groupId>
	<artifactId>smart-idp-connector</artifactId>
	<version>2.0.0</version>
	<packaging>mule-extension</packaging>

	<name>Smart IDP Connector</name>
	<description>
		Smart Mule 4 connector for MuleSoft Intelligent Document Processing (IDP).
		One Process Document operation validates the file against the IDP limits, submits it, and either waits for the
		extracted result, lets IDP call a callback URL, or both. Document actions and versions are picked from Exchange
		with a Connected App, and "latest" always runs the newest published version.
	</description>
	<url>https://github.com/vijaykumarkothapalli-vk/smart-idp-connector</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>vijaykumarkothapalli</id>
			<name>Vijay Kumar Kothapalli</name>
			<email>vijaykumarstar111@gmail.com</email>
			<url>https://www.linkedin.com/in/vijay-kumar-kothapalli</url>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/VijayKumarKothapalli-VK/smart-idp-connector</url>
		<connection>scm:git:https://github.com/VijayKumarKothapalli-VK/smart-idp-connector.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/VijayKumarKothapalli-VK/smart-idp-connector.git</developerConnection>
